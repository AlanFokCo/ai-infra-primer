---
import manifest from '../generated/manifest.json';
import { DIMENSIONS } from '../lib/dimensions.mjs';

interface Props {
  dim?: string;
}
const { dim = 'models' } = Astro.props;
const base = import.meta.env.BASE_URL;
const g = DIMENSIONS[dim].graph;
const parts = manifest.dimensions[dim]?.parts ?? [];
---

<svg viewBox={g.viewBox} role="img" aria-label={g.aria} class="dep-graph">
  <defs>
    <marker id={`arrow-${dim}`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L8,4 L0,8" fill="none" stroke="var(--ink-faint)" stroke-width="1.2" />
    </marker>
  </defs>
  <g class="edges">
    {
      g.edges.map((e) =>
        e.line ? (
          <line x1={e.line[0]} y1={e.line[1]} x2={e.line[2]} y2={e.line[3]} marker-end={`url(#arrow-${dim})`} />
        ) : (
          <Fragment>
            <path d={e.path} marker-end={`url(#arrow-${dim})`} />
            {e.label && (
              <text x={e.label.x} y={e.label.y} class="edge-label">
                {e.label.text}
              </text>
            )}
          </Fragment>
        )
      )
    }
  </g>
  {
    g.nodes.map((node) => {
      const p = parts.find((q) => q.num === node.n);
      const inner = (
        <g transform={`translate(${node.x}, ${node.y})`}>
          <rect width="92" height="52" rx="2" />
          <text x="12" y="20" class="node-num">P{node.n}</text>
          <text x="12" y="40" class="node-title">{p ? p.titleZh : ''}</text>
        </g>
      );
      // 建设期维度允许节点尚无对应 Part（training W1 前）：渲染为不可点节点
      return p ? (
        <a href={`${base}/${dim}/${p.dir}/`} class="graph-node">
          {inner}
        </a>
      ) : (
        <g class="graph-node graph-node-pending">{inner}</g>
      );
    })
  }
</svg>

<style>
  .dep-graph { display: block; min-width: 720px; width: 100%; height: auto; }
  .edges line, .edges path {
    stroke: var(--ink-faint);
    stroke-width: 1;
    fill: none;
    opacity: 0.75;
  }
  .edge-label { font-family: var(--font-mono); font-size: 10px; fill: var(--ink-faint); }
  .graph-node rect {
    fill: var(--paper);
    stroke: var(--rule);
    stroke-width: 1;
    transition: fill var(--dur-fast) var(--ease-out), stroke var(--dur-fast) var(--ease-out);
  }
  .graph-node .node-num { font-family: var(--font-mono); font-size: 10px; fill: var(--seal); }
  .graph-node .node-title { font-family: var(--font-serif); font-weight: 700; font-size: 13px; fill: var(--ink); }
  .graph-node:hover rect { fill: var(--seal-wash); stroke: var(--seal); }
  .graph-node-pending { opacity: 0.55; }
</style>
