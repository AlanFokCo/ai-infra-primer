---
import '@fontsource/noto-serif-sc/700.css';
import '@fontsource/noto-serif-sc/900.css';
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../generated/katex.min.css';
import '../styles/tokens.css';
import '../styles/base.css';
import manifest from '../generated/manifest.json';
import SearchBox from '../components/SearchBox.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const stats = manifest.stats;
const desc =
  description ??
  `一套把 AI 基础设施算到公式级的中文教程：${stats.chapters} 章 · ${stats.parts} Part · ${(stats.totalCjk / 10000).toFixed(1)} 万字`;

const isModels = path.startsWith(`${base}/models`);
const isRefs = path.startsWith(`${base}/models/references`);
---

<html lang="zh-CN" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === '首页' ? 'ai-infra-primer — from tokens to teraflops' : `${title} · ai-infra-primer`}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`https://alanfokco.github.io${base}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header" data-pagefind-ignore>
      <a class="site-wordmark" href={`${base}/`} aria-label="ai-infra-primer 首页">
        <span class="site-seal" aria-hidden="true">算</span>
        <span class="wordmark-text">ai-infra-primer</span>
      </a>
      <SearchBox />
      <nav class="site-nav" aria-label="主导航">
        <a href={`${base}/models/`} aria-current={isModels && !isRefs ? 'page' : undefined}>教程</a>
        <a href={`${base}/models/references/`} aria-current={isRefs ? 'page' : undefined}>文献</a>
        <a href="https://github.com/AlanFokCo/ai-infra-primer" rel="noopener">github</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <span class="colophon">
        {stats.chapters} 章 · {stats.parts} Part · {(stats.totalCjk / 10000).toFixed(1)} 万字 · {(stats.formulas ?? 0).toLocaleString('en-US')} 式
      </span>
      <span>构建期 KaTeX 渲染 · 由 GitHub Actions 自动部署</span>
      <span style="margin-left:auto">
        <a href="https://github.com/AlanFokCo/ai-infra-primer" rel="noopener">AlanFokCo/ai-infra-primer</a>
      </span>
    </footer>
  </body>
</html>
