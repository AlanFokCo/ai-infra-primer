---
import Base from '../../layouts/Base.astro';
import DependencyGraph from '../../components/DependencyGraph.astro';
import manifest from '../../generated/manifest.json';
import { DIMENSIONS } from '../../lib/dimensions.mjs';

export function getStaticPaths() {
  // 维度门槛：有已发布章节才生成该维度页面（training 在 W1 首波落地时自动出现）
  return Object.entries(manifest.dimensions)
    .filter(([, d]) => d.stats.chapters > 0)
    .map(([key]) => ({ params: { dim: key } }));
}

const { dim } = Astro.params;
const cfg = DIMENSIONS[dim];
const dimData = manifest.dimensions[dim];
const stats = dimData.stats;
const base = import.meta.env.BASE_URL;
---

<Base title={`${dim} 维度`} description={`${cfg.scope}。关键公式完整推导不跳步、逐公式附符号表、与官方实现代码对照；数值事实全部带出处并标注证据等级。`}>
  <div class="models-page">
    <header class="models-head">
      <p class="ch-num-big">{cfg.orderLabel}</p>
      <h1 class="models-title">{dim} <span class="title-zh">{cfg.zh}</span></h1>
      <p class="models-lede">{cfg.lede}</p>
      <p class="ch-ledger">
        <span>{stats.chapters} 章</span>
        <span>{(stats.totalCjk / 10000).toFixed(1)} 万字</span>
        <span>{stats.formulas.toLocaleString('en-US')} 式</span>
        {cfg.ledgerNote && <span>{cfg.ledgerNote}</span>}
      </p>
    </header>

    <section aria-labelledby="dep-h" class="models-section">
      <h2 id="dep-h" class="section-title">依赖图</h2>
      <p class="section-note">{cfg.depNote}</p>
      <div class="graph-wrap">
        <DependencyGraph dim={dim} />
      </div>
    </section>

    <section aria-labelledby="pre-h" class="models-section">
      <h2 id="pre-h" class="section-title">前置知识</h2>
      <ul class="pre-list">
        {cfg.prereqs.map((p) => <li set:html={p} />)}
      </ul>
      <p class="section-note">{cfg.prereqNote}</p>
    </section>

    <section aria-labelledby="all-h" class="models-section">
      <h2 id="all-h" class="section-title">全部章节</h2>
      {
        dimData.parts.map((p) => (
          <div class="index-part">
            <h3 class="index-part-head">
              <a href={`${base}/${dim}/${p.dir}/`}>
                <span class="mono-num">P{p.num}</span>
                <span class="part-zh">{p.titleZh}</span>
                <span class="part-en">{p.titleEn}</span>
              </a>
            </h3>
            <ol class="index-list">
              {p.chapters.map((c) => (
                <li>
                  <a class="index-row" href={`${base}/${dim}/${c.slug}/`}>
                    <span class="mono-num">{c.num}</span>
                    <span class="index-title">{c.titleZh}</span>
                    <span class="index-stats">{(c.cjkChars / 1000).toFixed(1)}k 字 · {c.formulas ?? 0} 式</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .models-page {
    max-width: 56rem;
    margin: 0 auto;
    padding: var(--space-8) var(--page-gutter) var(--space-16);
  }
  .ch-num-big {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--seal);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
  }
  .models-title {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-2);
  }
  .models-title .title-zh {
    font-family: var(--font-serif);
    font-weight: 900;
    margin-left: var(--space-3);
  }
  .models-lede {
    font-size: var(--text-md);
    line-height: 1.9;
    color: var(--ink-soft);
    max-width: 36em;
    margin: 0 0 var(--space-4);
  }
  .ch-ledger {
    display: flex;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--ink-faint);
    margin: 0 0 var(--space-12);
  }
  .models-section { margin-bottom: var(--space-12); }
  .section-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--text-xl);
    margin: 0 0 var(--space-3);
  }
  .section-note {
    color: var(--ink-faint);
    font-size: var(--text-sm);
    line-height: 1.9;
    margin: 0 0 var(--space-6);
    max-width: 44em;
  }
  .graph-wrap {
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    padding: var(--space-6);
    overflow-x: auto;
  }
  .pre-list {
    margin: 0 0 var(--space-4);
    padding-left: 1.4em;
    color: var(--ink-soft);
    line-height: 1.9;
    font-size: var(--text-base);
  }
  .pre-list li { margin-bottom: var(--space-2); }
  .pre-list li::marker { color: var(--seal); }
  .pre-list strong { color: var(--ink); }

  .index-part { margin-bottom: var(--space-8); }
  .index-part-head { margin: 0 0 var(--space-2); }
  .index-part-head a {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .index-part-head a:hover .part-zh { color: var(--seal); }
  .mono-num { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--seal); }
  .part-zh { font-family: var(--font-serif); font-weight: 700; font-size: var(--text-md); }
  .part-en { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--ink-faint); }
  .index-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .index-row {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-2) var(--space-2);
    border-bottom: 1px solid var(--rule-soft);
    font-size: var(--text-sm);
    transition: background var(--dur-fast) var(--ease-out);
  }
  .index-row:hover { background: var(--seal-wash); }
  .index-title { color: var(--ink); }
  .index-stats {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--ink-faint);
    white-space: nowrap;
  }
  @media (max-width: 40rem) {
    .index-stats { display: none; }
    .index-row { grid-template-columns: 2.6rem 1fr; }
  }
</style>
