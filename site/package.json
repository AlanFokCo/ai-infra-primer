{
  "name": "ai-infra-primer-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:content && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:content": "node scripts/build-content.mjs",
