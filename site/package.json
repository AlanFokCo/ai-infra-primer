    "astro": "^5.16.0",
    "katex": "^0.16.25",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "pagefind": "^1.4.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0"
  }
